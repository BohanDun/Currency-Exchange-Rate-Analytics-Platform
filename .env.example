# PostgreSQL
POSTGRES_DB=exchange_rates
POSTGRES_USER=exchange_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Data source
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
BASE_CURRENCY=EUR
QUOTE_CURRENCIES=USD,GBP,NZD,AUD,JPY
LOG_LEVEL=INFO
PIPELINE_TIMEZONE=Pacific/Auckland

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=replace_with_a_random_secret_of_at_least_64_characters
AIRFLOW_API_SECRET_KEY=replace_with_another_long_random_secret
